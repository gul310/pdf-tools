<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect non-HTTPS to HTTPS in production
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Direct file or directory requests
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirect legacy paths
  RewriteRule ^delete-pages/?$ /delete-pdf-pages [R=301,L]
  RewriteRule ^add-watermark/?$ /add-watermark-pdf [R=301,L]

  # Route all other URLs to index.html for Single Page Application
  RewriteRule ^ index.html [L]
</IfModule>

# Correct MIME Types for WebAssembly, Modern JS Workers, and SVGs
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType text/javascript .mjs
  AddType text/javascript .js
  AddType image/svg+xml .svg
  AddType application/json .json
</IfModule>

# Browser Caching for Immutable Static Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Cross-Origin Isolation for high-performance WASM if needed
  # Header set Cross-Origin-Embedder-Policy "require-corp"
  # Header set Cross-Origin-Opener-Policy "same-origin"
</IfModule>
